# Worker name
APP_NAME=opcstack
# Public app domain
# Local use localhost and pre-build reads vite --port from pnpm dev
# Production use your domain or subdomain
APP_DOMAIN=localhost
# Optional China mainland acceleration entry domain, for example cn.example.com
# Set this to your own cn subdomain, then point its DNS CNAME to the preferred Cloudflare domain cf.090227.xyz
# Used only as an extra Worker custom domain and Turnstile domain
# It does not replace APP_DOMAIN for SEO, sitemap, payment return urls, or email links
# Empty disables the extra China mainland entry
APP_CN_DOMAIN=
# Support contact used by legal pages
SUPPORT_EMAIL=support@example.com
# Design system style
# apple-saas or brutalism
DESIGN_SYSTEM=apple-saas

# Better Auth secret key
# Plain string works
# Must be non-empty
# 32+ chars is recommended
# Changing it invalidates existing sessions
BETTER_AUTH_SECRET=7e589363549f0013a5c984b343e6606f32e30ba2078cf8c4c0267df89edac909
# Super admin email
SUPER_ADMIN_EMAIL=admin@example.com
# Super admin password
SUPER_ADMIN_PASSWORD=Pwd123456
# Admin machine api token
ADMIN_API_TOKEN=change-me-admin-api-token

# Enable email auth feature
# true enables email auth routes
# false disables all email auth routes
EMAIL_ENABLED=true
# Email provider
# resend or cloudflare
EMAIL_PROVIDER=resend
# Enable email signup
# true allows /api/auth/sign-up/email
# false blocks email signup
EMAIL_SIGNUP_ENABLED=true
# Signup email domain allowlist separated by ';'
# Empty means no signup domain restriction
EMAIL_SIGNUP_DOMAIN_ALLOWLIST=
# Require email verification after signup
# true requires verify-email before sign-in
# false allows sign-in without verification
EMAIL_REQUIRE_VERIFICATION=true
# Cooldown window for user email actions in seconds
# Must be a positive integer
EMAIL_USER_ACTION_COOLDOWN_SECONDS=50
# Resend API key for resend email provider
# Required when EMAIL_ENABLED=true and EMAIL_PROVIDER=resend
EMAIL_RESEND_API_KEY=xxxx
# Email from header
# Required when EMAIL_ENABLED=true
EMAIL_FROM=xxxx@yourdomain

# Enable Google login flow
# true enables Google login
# false disables Google login endpoints
GOOGLE_AUTH_ENABLED=false
# Google OAuth client id
# Keep non-empty in current template
GOOGLE_CLIENT_ID=xxxx
# Google OAuth client secret
# Keep non-empty in current template
GOOGLE_CLIENT_SECRET=xxxx

# Enable beta code requirement
# true requires beta code
# false skips beta code check
BETA_CODE_ENABLED=false

# Tenant shard regions and counts
# wnam Western North America
# enam Eastern North America
# weur Western Europe
# eeur Eastern Europe
# apac Asia Pacific
# oc Oceania
D1_SHARDS=wnam:1;apac:1

# Enable Cloudflare Turnstile for email auth
# Local mode uses Cloudflare official test keys
# Remote mode creates or reuses a widget named APP_NAME
TURNSTILE_ENABLED=false

# Enable signup reward
CREDITS_SIGNUP_ENABLED=true
# Signup reward amount as decimal string with up to 6 fractional digits
CREDITS_SIGNUP_AMOUNT=100

# Enable daily checkin reward
CREDITS_DAILY_CHECKIN_ENABLED=true
# Daily checkin reward amount as decimal string with up to 6 fractional digits
CREDITS_DAILY_CHECKIN_AMOUNT=10

# Enable aff reward
AFF_ENABLED=true
# Aff inviter credit amount as decimal string with up to 6 fractional digits
AFF_INVITER_CREDIT_AMOUNT=50
# Aff invitee credit amount as decimal string with up to 6 fractional digits
AFF_INVITEE_CREDIT_AMOUNT=20

# Retention days for credit_transactions cleanup
CREDITS_HISTORY_RETENTION_DAYS=90

# Enable R2 binding
# true adds R2 binding
# false disables R2 binding
R2_ENABLED=false
# User direct upload allowed content types separated by semicolon
R2_USER_UPLOAD_ALLOWED_CONTENT_TYPES=image/png;image/jpeg;image/webp
# User direct upload max object size in bytes
R2_USER_UPLOAD_MAX_BYTES=5242880
# HMAC secret for internal R2 image origin
R2_ORIGIN_SIGNING_SECRET=change-me-r2-origin-signing-secret
# Tmp object lifecycle rules separated by ';'
# Only tmp/public/ and tmp/private/ are allowed
R2_TMP_LIFECYCLE_RULES=tmp/public/:7;tmp/private/:4

# Enable payment purchase entry
PAYMENT_ENABLED=false
# Default provider
PAYMENT_PROVIDER=creem
# Country based provider overrides in JSON
PAYMENT_PROVIDER_COUNTRY_OVERRIDES=[{"country":"CN","provider":"dodo"}]
# Product config in JSON
# credits_amount and period_credits_amount use decimal strings
PAYMENT_PRODUCTS=[]

# Dodo provider config
PAYMENT_DODO_API_KEY=xxxx
PAYMENT_DODO_WEBHOOK_SECRET=xxxx
PAYMENT_DODO_TEST_MODE=true

# Creem provider config
PAYMENT_CREEM_API_KEY=xxxx
PAYMENT_CREEM_WEBHOOK_SECRET=xxxx
PAYMENT_CREEM_TEST_MODE=true

# Queue names separated by ';'
# Example QUEUE_NAMES=task-check;notify-send
# Empty means no queue bindings and no consumers in wrangler config
QUEUE_NAMES=tts-generate;image-generate
# Optional Cloudflare Queue consumer max concurrency, valid range is 1-250
QUEUE_MAX_CONCURRENCY=

# Cron expressions separated by ';'
# Example CRONS=*/5 * * * *;0 3 * * *
# Empty means no cron triggers in wrangler config
CRONS=*/10 * * * *

# OpenAI compatible base url
# Used by chat client at runtime
CHAT_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI compatible api key
CHAT_OPENAI_API_KEY=xxx
# OpenAI chat model name
# Runtime default chat model
CHAT_OPENAI_MODEL=gpt-5.4-mini

# Gemini image api base url
# Used by image client at runtime
IMAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Gemini image api key
IMAGE_GEMINI_API_KEY=xxxxx
# Gemini image model name
# Runtime default image model
IMAGE_GEMINI_MODEL=gemini-3.1-flash-image-preview

# OpenAI image base url
# Used by image client at runtime
IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI image api key
IMAGE_OPENAI_API_KEY=xxxx
# OpenAI image model name
# Runtime default image model
IMAGE_OPENAI_MODEL=gpt-image-2

# SeedDream image base url
# Used by image client at runtime
IMAGE_SEEDDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SeedDream image api key
IMAGE_SEEDDREAM_API_KEY=xxxx
# SeedDream image model name
# Runtime default image model
IMAGE_SEEDDREAM_MODEL=doubao-seedream-5-0-260128

# Gemini tts api base url
# Used by tts client at runtime
TTS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Gemini tts api key
TTS_GEMINI_API_KEY=xxxxx
# Gemini tts model name
# Runtime default tts model
TTS_GEMINI_MODEL=gemini-3.1-flash-tts-preview
