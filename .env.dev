# Application identity used by Worker, generated Cloudflare resources, UI, and extension artifacts
# Keep this lowercase and stable because prepare-cloudflare uses it as the Worker name and resource prefix
APP_NAME=opcstack

# Product version exposed to Worker, web client, and extension build artifacts
# Bump this only when releasing user-visible behavior or packaged extension changes
APP_VERSION=0.1.0

# UI design system selected at build and deployment time; changing it requires rebuilding and redeploying the Worker
# Valid values are apple-saas and brutalism
DESIGN_SYSTEM=apple-saas

# Email for the unique administrator created when Meta D1 is empty
# Runtime identity, support contact, and outbound sender use the created D1 account; later prepares never overwrite it
SYSTEM_EMAIL=

# Primary public app domain without protocol
# Local dev resolves APP_BASE_URL from the Vite dev port even when this is localhost
# Production uses this for Worker routes, canonical URLs, OAuth callbacks, payment webhooks, and R2 CORS
APP_DOMAIN=localhost

# Optional China access domain without protocol
# Set this only when the product needs a separate China entrypoint,
# usually for DNS acceleration or preferred routing outside the normal Cloudflare proxied path
# When set, prepare-cloudflare adds a second Worker custom domain, R2 CORS origin, and Turnstile domain
APP_CN_DOMAIN=

# Optional DNS CNAME target for APP_CN_DOMAIN
# Empty keeps DNS untouched; when both values are set in prod, prepare-cloudflare creates or updates one unproxied CNAME
# Use the target from the DNS acceleration provider; do not point it back to APP_DOMAIN
APP_CN_CNAME_TARGET=youxuan.cf.090227.xyz

# Chrome extension host permissions separated by semicolon
# WXT copies this into the extension manifest; keep dev limited to the local app origin
EXTENSION_HOST_PERMISSIONS=http://localhost:5173/*

# Tenant D1 shard layout separated by semicolon as region:count
# Supported regions are wnam, enam, weur, eeur, apac, and oc
# Meta DB is created as APP_NAME-meta without a region hint, so Cloudflare places its primary automatically near the prepare-cloudflare request origin
# Tenant shard DBs use these region hints and are registered in d1_shards
# New users prefer the Worker continent bucket, then any active shard; existing users always follow user_shards
# Docs: https://developers.cloudflare.com/d1/
D1_SHARDS=apac:1

# Enable Cloudflare R2 binding and bucket provisioning
# false removes the R2 binding from generated wrangler config and disables the shared object bucket path
# Docs: https://developers.cloudflare.com/r2/
R2_ENABLED=false

# MIME types accepted by user and admin uploads, separated by semicolon
# Worker validates this at prepare time and uses it directly for every upload
R2_USER_UPLOAD_ALLOWED_CONTENT_TYPES=image/png;image/jpeg;image/webp

# Maximum upload size in bytes; 5242880 is 5 MiB
# Worker validates this at prepare time and rejects larger uploads
R2_USER_UPLOAD_MAX_BYTES=5242880

# Temporary R2 object lifecycle rules separated by semicolon as prefix:days
# Only tmp/public/ and tmp/private/ are valid prefixes; empty disables lifecycle rule sync
R2_TMP_LIFECYCLE_RULES=tmp/public/:7;tmp/private/:1

# Queue names separated by semicolon
# prepare-cloudflare creates bindings such as image-generate -> Q_IMAGE_GENERATE and routes messages to consumers
# Empty means no queue bindings and no consumers in generated wrangler config
# Docs: https://developers.cloudflare.com/queues/
QUEUE_NAMES=image-generate;tts-generate;video-generate

# Optional Cloudflare Queue consumer max concurrency
# Empty keeps Cloudflare default consumer behavior; set it only when provider rate limits force throttling
QUEUE_MAX_CONCURRENCY=

# Cron expressions separated by semicolon
# */10 * * * * drives the existing periodic business jobs every 10 minutes; changing it changes real task polling and cleanup cadence
# Empty means no cron triggers in generated wrangler config
# Docs: https://developers.cloudflare.com/workers/configuration/cron-triggers/
CRONS=*/10 * * * *

# Durable Object names separated by semicolon
# Use Durable Objects only for per-object serial coordination, WebSocket rooms, alarms, or small object-local state
# Empty means no Durable Object bindings or migrations
# Docs: https://developers.cloudflare.com/durable-objects/
DO_NAMES=
