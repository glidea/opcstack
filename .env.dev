# Application identity used by Worker, generated Cloudflare resources, UI, and extension artifacts
# Keep this lowercase and stable because prepare-cloudflare uses it as the Worker name and resource prefix
APP_NAME=opcstack

# Product version exposed to Worker, web client, and extension build artifacts
# Bump this only when releasing user-visible behavior or packaged extension changes
APP_VERSION=0.1.0

# Operator mailbox used for support contact, initial admin account, and outbound email sender
# prepare-cloudflare seeds this email as the super admin login account
# The initial super admin password comes from SUPER_ADMIN_PASSWORD in the secret env file
# Use a monitored address on a verified sending domain when email delivery is enabled
SYSTEM_EMAIL=yourfriend@glidea.app

# Primary public app domain without protocol
# Local dev resolves APP_BASE_URL from the Vite dev port even when this is localhost
# Production uses this for Worker routes, canonical URLs, OAuth callbacks, payment webhooks, and R2 CORS
APP_DOMAIN=localhost

# Optional China access domain without protocol
# Set this only when the product needs a separate China entrypoint,
# usually for DNS acceleration or preferred routing outside the normal Cloudflare proxied path
# When set, prepare-cloudflare adds a second Worker custom domain, R2 CORS origin, and Turnstile domain
APP_CN_DOMAIN=

# Optional DNS CNAME target for APP_CN_DOMAIN
# Empty keeps DNS untouched; when both values are set in prod, prepare-cloudflare creates or updates one unproxied CNAME
# Use the target from the DNS acceleration provider; do not point it back to APP_DOMAIN
APP_CN_CNAME_TARGET=youxuan.cf.090227.xyz

# Chrome extension host permissions separated by semicolon
# WXT copies this into the extension manifest; keep dev limited to the local app origin
EXTENSION_HOST_PERMISSIONS=http://localhost:5173/*

# Enable beta code requirement during auth gated flows
# false lets users pass the beta gate without a redemption code
BETA_CODE_ENABLED=false

# Email provider used by backend auth and notification email delivery
# cloudflare uses the Worker SEND_EMAIL binding and requires a paid Worker plan
# resend uses Resend API and requires EMAIL_RESEND_API_KEY in the secret env file
EMAIL_PROVIDER=cloudflare

# Enable public email signup
# false keeps email login and password reset available but blocks new email registration
EMAIL_SIGNUP_ENABLED=true

# Signup email domain allowlist separated by semicolon
# Empty allows every email domain; set this only for a closed beta or internal rollout
EMAIL_SIGNUP_DOMAIN_ALLOWLIST=

# Require email verification after signup
# Keep false in local dev unless the email provider is configured and deliverable
EMAIL_REQUIRE_VERIFICATION=false

# Cooldown window for user email actions in seconds
# Controls resend and reset abuse pressure; lower values make local testing easier
EMAIL_USER_ACTION_COOLDOWN_SECONDS=50

# Enable Cloudflare Turnstile for email auth forms
# In local dev, prepare-cloudflare uses Cloudflare test credentials
# In prod, prepare-cloudflare can create or reuse a Turnstile widget for APP_DOMAIN and APP_CN_DOMAIN
# Docs: https://developers.cloudflare.com/turnstile/
TURNSTILE_ENABLED=false

# Enable Google OAuth login
# Requires GOOGLE_CLIENT_ID here and GOOGLE_CLIENT_SECRET in the secret env file
# Configure the callback URL from APP_DOMAIN in Google Cloud Console OAuth client settings
# Docs: https://developers.google.com/identity/protocols/oauth2
GOOGLE_AUTH_ENABLED=false

# Google OAuth client id
# Public id from Google Cloud Console OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

# Enable GitHub OAuth login
# Requires GITHUB_CLIENT_ID here and GITHUB_CLIENT_SECRET in the secret env file
# Configure the callback URL from APP_DOMAIN in the GitHub OAuth App
# Docs: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
GITHUB_AUTH_ENABLED=false

# GitHub OAuth client id
# Public id from GitHub Developer settings OAuth Apps
GITHUB_CLIENT_ID=

# Enable LinuxDO OAuth login
# Requires LINUXDO_CLIENT_ID here and LINUXDO_CLIENT_SECRET in the secret env file
# Configure the callback URL from APP_DOMAIN in the LinuxDO OAuth application console
LINUXDO_AUTH_ENABLED=false

# LinuxDO OAuth client id
# Public id from the LinuxDO OAuth application console
LINUXDO_CLIENT_ID=

# Tenant D1 shard layout separated by semicolon as region:count
# Supported regions are wnam, enam, weur, eeur, apac, and oc
# Meta DB is created as APP_NAME-meta without a region hint, so Cloudflare places its primary automatically near the prepare-cloudflare request origin
# Tenant shard DBs use these region hints and are registered in d1_shards
# New users prefer the Worker continent bucket, then any active shard; existing users always follow user_shards
# Docs: https://developers.cloudflare.com/d1/
D1_SHARDS=apac:1

# Enable Cloudflare R2 binding and bucket provisioning
# false removes the R2 binding from generated wrangler config and disables the shared object bucket path
# Docs: https://developers.cloudflare.com/r2/
R2_ENABLED=false

# Temporary R2 object lifecycle rules separated by semicolon as prefix:days
# Only tmp/public/ and tmp/private/ are valid prefixes; empty disables lifecycle rule sync
R2_TMP_LIFECYCLE_RULES=tmp/public/:7;tmp/private/:1

# Queue names separated by semicolon
# prepare-cloudflare creates bindings such as image-generate -> Q_IMAGE_GENERATE and routes messages to consumers
# Empty means no queue bindings and no consumers in generated wrangler config
# Docs: https://developers.cloudflare.com/queues/
QUEUE_NAMES=image-generate;tts-generate;video-generate

# Optional Cloudflare Queue consumer max concurrency
# Empty keeps Cloudflare default consumer behavior; set it only when provider rate limits force throttling
QUEUE_MAX_CONCURRENCY=

# Cron expressions separated by semicolon
# */10 * * * * drives the existing periodic business jobs every 10 minutes; changing it changes real task polling and cleanup cadence
# Empty means no cron triggers in generated wrangler config
# Docs: https://developers.cloudflare.com/workers/configuration/cron-triggers/
CRONS=*/10 * * * *

# Durable Object names separated by semicolon
# Use Durable Objects only for per-object serial coordination, WebSocket rooms, alarms, or small object-local state
# Empty means no Durable Object bindings or migrations
# Docs: https://developers.cloudflare.com/durable-objects/
DO_NAMES=

# Enable signup credit grant
# false skips the credit side effect during signup
CREDITS_SIGNUP_ENABLED=false

# Signup credit amount in product credits
# Parsed as decimal credits, not raw credit units; 1 credit equals 1000000 internal units
CREDITS_SIGNUP_AMOUNT=100

# Enable daily checkin credit grant
# false disables the daily checkin reward endpoint behavior
CREDITS_DAILY_CHECKIN_ENABLED=false

# Daily checkin credit amount in product credits
# Keep this aligned with real AI provider cost before enabling public traffic
CREDITS_DAILY_CHECKIN_AMOUNT=10

# Enable affiliate referral features
# false hides or blocks referral reward behavior
AFF_ENABLED=false

# Affiliate inviter reward amount in product credits
# Keep inviter and invitee rewards explicit so abuse cost is visible in config
AFF_INVITER_CREDIT_AMOUNT=50

# Affiliate invitee reward amount in product credits
# Keep this below the signup abuse cost tolerance
AFF_INVITEE_CREDIT_AMOUNT=20

# Retention days for credit_transactions cleanup job
# Choose a value that still covers support and audit needs before lowering it
CREDITS_HISTORY_RETENTION_DAYS=90

# Enable payment purchase entry
# true exposes real purchase flows and requires provider secrets plus a non-empty PAYMENT_PRODUCTS catalog
PAYMENT_ENABLED=false

# Default payment provider
# Must be one provider that appears in PAYMENT_PRODUCTS when payments are enabled
# Keep one default provider; use country overrides only when a market must route to a different configured provider
PAYMENT_PROVIDER=creem

# Country based payment provider overrides in JSON
# Use this when a visitor country needs a different provider catalog or checkout path, for example routing CN to Dodo
# Providers listed here must also exist in PAYMENT_PRODUCTS
PAYMENT_PROVIDER_COUNTRY_OVERRIDES=[{"country":"CN","provider":"dodo"}]

# Use Dodo test environment
# true sends Dodo requests to the provider test environment; set false only after live products, webhooks, and secrets are verified
PAYMENT_DODO_TEST_MODE=true

# Use Creem test environment
# true sends Creem requests to the provider test environment; set false only after live products, webhooks, and secrets are verified
PAYMENT_CREEM_TEST_MODE=true

# Payment product catalog in JSON
# Empty array disables purchasable products even when PAYMENT_ENABLED=true
# Top-level value is an array of product objects
# product_id is the internal stable product id passed to checkout APIs; it is not the provider product id
# type is one_time or subscription and must match the provider product billing mode
# credits_amount is a decimal credit amount granted once after a successful one_time payment; omit it for subscription-only products
# subscription_plan is the internal plan name stored on user subscriptions; set it for subscription products
# upgrade_rank is an integer used to reject downgrade or same-rank subscription upgrades; higher means a stronger plan
# period_credits_amount is a decimal credit amount granted for each paid subscription period
# providers maps dodo or creem to that provider's product config; PAYMENT_PROVIDER and country overrides can only select providers listed here
# Current Dodo and Creem checkout paths require {"kind":"remote_product","product_id":"provider_product_id"}
# Example one_time: [{"product_id":"credits_100","type":"one_time","credits_amount":"100","providers":{"creem":{"kind":"remote_product","product_id":"prod_creem_x"}}}]
# Example subscription: [{"product_id":"pro_monthly","type":"subscription","subscription_plan":"pro","upgrade_rank":20,"period_credits_amount":"3000","providers":{"creem":{"kind":"remote_product","product_id":"prod_creem_pro"}}}]
# Dodo docs: https://docs.dodopayments.com/api-reference/introduction
# Creem docs: https://docs.creem.io/api-reference/introduction
PAYMENT_PRODUCTS=[]

# OpenAI-compatible chat API base URL
# Runtime chat client sends requests here; keep the /v1-compatible endpoint
CHAT_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI-compatible chat model name
# Runtime default chat model; get valid names from the selected provider
CHAT_OPENAI_MODEL=gpt-5.4-mini

# Gemini image API base URL
# Runtime Gemini image client endpoint; keep the official Google Generative Language endpoint unless using a compatible proxy
IMAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Gemini image model name
# Runtime default Gemini image model
IMAGE_GEMINI_MODEL=gemini-3.1-flash-image-preview

# OpenAI image API base URL
# Runtime OpenAI image client endpoint; keep the /v1-compatible endpoint
IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI image model name
# Runtime default OpenAI image model
IMAGE_OPENAI_MODEL=gpt-image-2

# SeedDream image API base URL
# Runtime SeedDream image client endpoint from Volcengine Ark
IMAGE_SEEDDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# SeedDream image model name
# Runtime default SeedDream image model
IMAGE_SEEDDREAM_MODEL=doubao-seedream-5-0-260128

# Aliyun image API base URL
# Runtime Aliyun image client endpoint from Alibaba Cloud DashScope
IMAGE_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Aliyun image model name
# Runtime default Aliyun image model
IMAGE_ALIYUN_MODEL=qwen-image-2.0-pro

# Gemini TTS API base URL
# Runtime Gemini TTS client endpoint; keep the official Google Generative Language endpoint unless using a compatible proxy
TTS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Gemini TTS model name
# Runtime default Gemini TTS model
TTS_GEMINI_MODEL=gemini-3.1-flash-tts-preview

# Seed TTS API base URL
# Runtime Seed TTS client endpoint from Volcengine OpenSpeech
TTS_SEED_BASE_URL=https://openspeech.bytedance.com/api/v3

# Seed TTS model name
# Runtime default Seed TTS model
TTS_SEED_MODEL=seed-tts-2.0-standard

# Doubao realtime API base URL
# Runtime realtime audio client endpoint from Volcengine OpenSpeech
REALTIME_DOUBAO_BASE_URL=https://openspeech.bytedance.com/api/v3

# Doubao realtime model name
# Runtime default realtime model
REALTIME_DOUBAO_MODEL=doubao-realtime-o2

# SeedDance video API base URL
# Runtime SeedDance video client endpoint from Volcengine Ark
VIDEO_SEEDDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# SeedDance video model name
# Runtime default video model
VIDEO_SEEDDANCE_MODEL=doubao-seedance-2-0-fast-260128

# Async AI routing error weight
# Higher values prefer channels with lower observed error rates
AI_ROUTING_ERROR_WEIGHT=1

# Async AI routing latency weight
# Higher values prefer channels with lower successful upstream latency
AI_ROUTING_LATENCY_WEIGHT=0.8

# Async AI routing price weight
# Higher values prefer channels with lower channel price multipliers
AI_ROUTING_PRICE_WEIGHT=0.2

# Terminal async AI task retention in days
# Cron removes completed and failed tasks older than this value
AI_TASK_RETENTION_DAYS=30

# Async AI channel groups use <AREA>_<PROVIDER>_<CHANNEL> as their ENV prefix
# CHANNEL is an uppercase identifier such as OFFICIAL or RESELLER_A and becomes the persisted metric identity
# Defining any channel field declares the channel; BASE_URL, MODELS, PRICE_MULTIPLIER, and the matching secret API_KEY are then all required
# Cloudflare preparation fails on partial groups instead of ignoring or defaulting missing values
# MODELS is a semicolon-separated allowlist; the router considers the channel only for an exact provider and model match
# Each configured async provider's default model must appear in at least one channel MODELS list
# PRICE_MULTIPLIER is a positive relative cost where 1 is the baseline, 0.8 means 20% cheaper, and 1.2 means 20% more expensive
# API keys belong in the secret env file under the same prefix and never inherit from the provider's synchronous API key

# Gemini image channel served by the official Google endpoint
# Provider root URL used for async requests; required and has no default
IMAGE_GEMINI_OFFICIAL_BASE_URL=https://generativelanguage.googleapis.com
# Exact Gemini image model ids accepted by this channel, separated by semicolons
IMAGE_GEMINI_OFFICIAL_MODELS=gemini-3.1-flash-image-preview
# Relative channel cost used by routing; 1 is the baseline official price
IMAGE_GEMINI_OFFICIAL_PRICE_MULTIPLIER=1

# OpenAI image channel served by the official OpenAI endpoint
# Provider root URL used for async requests; required and has no default
IMAGE_OPENAI_OFFICIAL_BASE_URL=https://api.openai.com/v1
# Exact OpenAI image model ids accepted by this channel, separated by semicolons
IMAGE_OPENAI_OFFICIAL_MODELS=gpt-image-2
# Relative channel cost used by routing; 1 is the baseline official price
IMAGE_OPENAI_OFFICIAL_PRICE_MULTIPLIER=1

# SeedDream image channel served by the official Volcengine Ark endpoint
# Provider root URL used for async requests; required and has no default
IMAGE_SEEDDREAM_OFFICIAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Exact SeedDream model ids accepted by this channel, separated by semicolons
IMAGE_SEEDDREAM_OFFICIAL_MODELS=doubao-seedream-5-0-260128
# Relative channel cost used by routing; 1 is the baseline official price
IMAGE_SEEDDREAM_OFFICIAL_PRICE_MULTIPLIER=1

# Aliyun image channel served by the official DashScope endpoint
# Provider root URL used for async requests; required and has no default
IMAGE_ALIYUN_OFFICIAL_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# Exact Aliyun image model ids accepted by this channel, separated by semicolons
IMAGE_ALIYUN_OFFICIAL_MODELS=qwen-image-2.0-pro
# Relative channel cost used by routing; 1 is the baseline official price
IMAGE_ALIYUN_OFFICIAL_PRICE_MULTIPLIER=1

# Gemini TTS channel served by the official Google endpoint
# Provider root URL used for async requests; required and has no default
TTS_GEMINI_OFFICIAL_BASE_URL=https://generativelanguage.googleapis.com
# Exact Gemini TTS model ids accepted by this channel, separated by semicolons
TTS_GEMINI_OFFICIAL_MODELS=gemini-3.1-flash-tts-preview
# Relative channel cost used by routing; 1 is the baseline official price
TTS_GEMINI_OFFICIAL_PRICE_MULTIPLIER=1

# Seed TTS channel served by the official ByteDance OpenSpeech endpoint
# Provider root URL used for async requests; required and has no default
TTS_SEED_OFFICIAL_BASE_URL=https://openspeech.bytedance.com/api/v3
# Exact Seed TTS model ids accepted by this channel, separated by semicolons
TTS_SEED_OFFICIAL_MODELS=seed-tts-2.0-standard
# Relative channel cost used by routing; 1 is the baseline official price
TTS_SEED_OFFICIAL_PRICE_MULTIPLIER=1

# SeedDance video channel served by the official Volcengine Ark endpoint
# Provider root URL used for async requests; required and has no default
VIDEO_SEEDDANCE_OFFICIAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Exact SeedDance model ids accepted by this channel, separated by semicolons
VIDEO_SEEDDANCE_OFFICIAL_MODELS=doubao-seedance-2-0-fast-260128
# Relative channel cost used by routing; 1 is the baseline official price
VIDEO_SEEDDANCE_OFFICIAL_PRICE_MULTIPLIER=1
