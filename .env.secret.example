# Copy this file to .env.secret.dev or .env.secret.prod, then fill real values
# Do not commit .env.secret.dev or .env.secret.prod
# Keep this file in the same business order as .env.dev and .env.prod

# Initial super admin password consumed by prepare-cloudflare during admin account seed
# This is a prepare-time secret, not a normal runtime business setting
# Use a unique strong password and rotate it after the first admin login if needed
SUPER_ADMIN_PASSWORD=

# Dodo API key
# Required when PAYMENT_ENABLED=true and a selected PAYMENT_PRODUCTS entry uses the dodo provider
# Use the matching test or live key for PAYMENT_DODO_TEST_MODE
# Docs: https://docs.dodopayments.com/api-reference/introduction
PAYMENT_DODO_API_KEY=

# Dodo webhook signing secret
# Required for Dodo webhook verification when Dodo products are configured
# Use the secret from the Dodo webhook endpoint that points to this app
PAYMENT_DODO_WEBHOOK_SECRET=

# Creem API key
# Required when PAYMENT_ENABLED=true and a selected PAYMENT_PRODUCTS entry uses the creem provider
# Use the matching test or live key for PAYMENT_CREEM_TEST_MODE
# Docs: https://docs.creem.io/api-reference/introduction
PAYMENT_CREEM_API_KEY=

# Creem webhook signing secret
# Required for Creem webhook verification when Creem products are configured
# Use the secret from the Creem webhook endpoint that points to this app
PAYMENT_CREEM_WEBHOOK_SECRET=

# OpenAI-compatible chat API key
# Required when chat generation uses CHAT_OPENAI_BASE_URL
# Use credentials from the same provider as the configured base URL
CHAT_OPENAI_API_KEY=

# Gemini image API key
# Required when Gemini image generation is used
# Use a key from Google AI Studio or Google Cloud for IMAGE_GEMINI_BASE_URL
IMAGE_GEMINI_API_KEY=

# OpenAI image API key
# Required when OpenAI image generation is used
# Use credentials from OpenAI or the selected OpenAI-compatible image provider
IMAGE_OPENAI_API_KEY=

# SeedDream image API key
# Required when SeedDream image generation is used
# Use credentials from Volcengine Ark for IMAGE_SEEDDREAM_BASE_URL
IMAGE_SEEDDREAM_API_KEY=

# Aliyun image API key
# Required when Aliyun image generation is used
# Use credentials from Alibaba Cloud DashScope for IMAGE_ALIYUN_BASE_URL
IMAGE_ALIYUN_API_KEY=

# Gemini TTS API key
# Required when Gemini TTS is used
# Use a key from Google AI Studio or Google Cloud for TTS_GEMINI_BASE_URL
TTS_GEMINI_API_KEY=

# Seed TTS API key
# Required when Seed TTS is used
# Use credentials from Volcengine OpenSpeech for TTS_SEED_BASE_URL
TTS_SEED_API_KEY=

# Doubao realtime API key
# Required when Doubao realtime audio is used
# Use credentials from Volcengine for REALTIME_DOUBAO_BASE_URL
REALTIME_DOUBAO_API_KEY=

# SeedDance video API key
# Required when SeedDance video generation is used
# Use credentials from Volcengine Ark for VIDEO_SEEDDANCE_BASE_URL
VIDEO_SEEDDANCE_API_KEY=

# Async channel secrets use the same <AREA>_<PROVIDER>_<CHANNEL> prefix as the public channel config
# Every configured channel requires its own API_KEY variable; values are never inherited from the synchronous provider key
# The value may be identical to the synchronous key when both endpoints use the same provider account

# Credential used only when the router selects the IMAGE_GEMINI_OFFICIAL channel
# Required because IMAGE_GEMINI_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw Google AI Studio or Google Cloud API key without a Bearer prefix
IMAGE_GEMINI_OFFICIAL_API_KEY=

# Credential used only when the router selects the IMAGE_OPENAI_OFFICIAL channel
# Required because IMAGE_OPENAI_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw OpenAI project API key without a Bearer prefix
IMAGE_OPENAI_OFFICIAL_API_KEY=

# Credential used only when the router selects the IMAGE_SEEDDREAM_OFFICIAL channel
# Required because IMAGE_SEEDDREAM_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw Volcengine Ark API key without a Bearer prefix
IMAGE_SEEDDREAM_OFFICIAL_API_KEY=

# Credential used only when the router selects the IMAGE_ALIYUN_OFFICIAL channel
# Required because IMAGE_ALIYUN_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw Alibaba Cloud DashScope API key without a Bearer prefix
IMAGE_ALIYUN_OFFICIAL_API_KEY=

# Credential used only when the router selects the TTS_GEMINI_OFFICIAL channel
# Required because TTS_GEMINI_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw Google AI Studio or Google Cloud API key without a Bearer prefix
TTS_GEMINI_OFFICIAL_API_KEY=

# Credential used only when the router selects the TTS_SEED_OFFICIAL channel
# Required because TTS_SEED_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw ByteDance OpenSpeech API key without a Bearer prefix
TTS_SEED_OFFICIAL_API_KEY=

# Credential used only when the router selects the VIDEO_SEEDDANCE_OFFICIAL channel
# Required because VIDEO_SEEDDANCE_OFFICIAL_BASE_URL is configured; there is no default
# Paste the raw Volcengine Ark API key without a Bearer prefix
VIDEO_SEEDDANCE_OFFICIAL_API_KEY=
