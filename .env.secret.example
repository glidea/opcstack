# Copy this file to .env.secret.dev or .env.secret.prod, then fill real values
# Do not commit .env.secret.dev or .env.secret.prod
# Keep this file in the same business order as .env.dev and .env.prod

# Better Auth signing secret used for session and token security
# Required by the auth runtime in every environment
# Generate a random 32+ character value with a password manager or openssl rand
BETTER_AUTH_SECRET=

# Initial super admin password consumed by prepare-cloudflare during admin account seed
# This is a prepare-time secret, not a normal runtime business setting
# Use a unique strong password and rotate it after the first admin login if needed
SUPER_ADMIN_PASSWORD=

# Admin API bearer token accepted by admin middleware
# Required only when automation needs admin API access without a browser session
# Generate a long random token and do not keep it in local shell history
ADMIN_API_TOKEN=

# Resend API key
# Required only when EMAIL_PROVIDER=resend
# Create it after the sender domain is verified in Resend
EMAIL_RESEND_API_KEY=

# Google OAuth client secret
# Required only when GOOGLE_AUTH_ENABLED=true
# Must belong to the same OAuth client as GOOGLE_CLIENT_ID
# Docs: https://developers.google.com/identity/protocols/oauth2
GOOGLE_CLIENT_SECRET=

# GitHub OAuth client secret
# Required only when GITHUB_AUTH_ENABLED=true
# Must belong to the same OAuth App as GITHUB_CLIENT_ID
# Docs: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
GITHUB_CLIENT_SECRET=

# LinuxDO OAuth client secret
# Required only when LINUXDO_AUTH_ENABLED=true
# Must belong to the same OAuth application as LINUXDO_CLIENT_ID
LINUXDO_CLIENT_SECRET=

# R2 origin URL signing secret
# Required by signed R2 origin read URLs when R2 routes are used
# Generate a long random value unrelated to Cloudflare credentials
R2_ORIGIN_SIGNING_SECRET=

# Cloudflare R2 S3 secret access key
# Used by backend S3-compatible upload helpers
# Prod prepare can generate and cache this from a scoped Cloudflare R2 token, so leave it empty when using the normal prepare flow
R2_SECRET_ACCESS_KEY=

# Dodo API key
# Required when PAYMENT_ENABLED=true and a selected PAYMENT_PRODUCTS entry uses the dodo provider
# Use the matching test or live key for PAYMENT_DODO_TEST_MODE
# Docs: https://docs.dodopayments.com/api-reference/introduction
PAYMENT_DODO_API_KEY=

# Dodo webhook signing secret
# Required for Dodo webhook verification when Dodo products are configured
# Use the secret from the Dodo webhook endpoint that points to this app
PAYMENT_DODO_WEBHOOK_SECRET=

# Creem API key
# Required when PAYMENT_ENABLED=true and a selected PAYMENT_PRODUCTS entry uses the creem provider
# Use the matching test or live key for PAYMENT_CREEM_TEST_MODE
# Docs: https://docs.creem.io/api-reference/introduction
PAYMENT_CREEM_API_KEY=

# Creem webhook signing secret
# Required for Creem webhook verification when Creem products are configured
# Use the secret from the Creem webhook endpoint that points to this app
PAYMENT_CREEM_WEBHOOK_SECRET=

# OpenAI-compatible chat API key
# Required when chat generation uses CHAT_OPENAI_BASE_URL
# Use credentials from the same provider as the configured base URL
CHAT_OPENAI_API_KEY=

# OpenAI-compatible chat fallback API key
# Required only when CHAT_OPENAI_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider, not the primary provider
CHAT_OPENAI_FALLBACK_API_KEY=

# Gemini image API key
# Required when Gemini image generation is used
# Use a key from Google AI Studio or Google Cloud for IMAGE_GEMINI_BASE_URL
IMAGE_GEMINI_API_KEY=

# Gemini image fallback API key
# Required only when IMAGE_GEMINI_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
IMAGE_GEMINI_FALLBACK_API_KEY=

# OpenAI image API key
# Required when OpenAI image generation is used
# Use credentials from OpenAI or the selected OpenAI-compatible image provider
IMAGE_OPENAI_API_KEY=

# OpenAI image fallback API key
# Required only when IMAGE_OPENAI_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
IMAGE_OPENAI_FALLBACK_API_KEY=

# SeedDream image API key
# Required when SeedDream image generation is used
# Use credentials from Volcengine Ark for IMAGE_SEEDDREAM_BASE_URL
IMAGE_SEEDDREAM_API_KEY=

# SeedDream image fallback API key
# Required only when IMAGE_SEEDDREAM_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
IMAGE_SEEDDREAM_FALLBACK_API_KEY=

# Aliyun image API key
# Required when Aliyun image generation is used
# Use credentials from Alibaba Cloud DashScope for IMAGE_ALIYUN_BASE_URL
IMAGE_ALIYUN_API_KEY=

# Aliyun image fallback API key
# Required only when IMAGE_ALIYUN_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
IMAGE_ALIYUN_FALLBACK_API_KEY=

# Gemini TTS API key
# Required when Gemini TTS is used
# Use a key from Google AI Studio or Google Cloud for TTS_GEMINI_BASE_URL
TTS_GEMINI_API_KEY=

# Gemini TTS fallback API key
# Required only when TTS_GEMINI_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
TTS_GEMINI_FALLBACK_API_KEY=

# Seed TTS API key
# Required when Seed TTS is used
# Use credentials from Volcengine OpenSpeech for TTS_SEED_BASE_URL
TTS_SEED_API_KEY=

# Seed TTS fallback API key
# Required only when TTS_SEED_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
TTS_SEED_FALLBACK_API_KEY=

# Doubao realtime API key
# Required when Doubao realtime audio is used
# Use credentials from Volcengine for REALTIME_DOUBAO_BASE_URL
REALTIME_DOUBAO_API_KEY=

# Doubao realtime fallback API key
# Required only when REALTIME_DOUBAO_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
REALTIME_DOUBAO_FALLBACK_API_KEY=

# SeedDance video API key
# Required when SeedDance video generation is used
# Use credentials from Volcengine Ark for VIDEO_SEEDDANCE_BASE_URL
VIDEO_SEEDDANCE_API_KEY=

# SeedDance video fallback API key
# Required only when VIDEO_SEEDDANCE_FALLBACK_BASE_URL is set
# Use credentials from the fallback provider
VIDEO_SEEDDANCE_FALLBACK_API_KEY=
