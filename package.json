{
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"opc": "scripts/opc.mjs"
	},
	"scripts": {
		"dev": "pnpm exec svelte-kit sync && pnpm prepare:cloudflare:dev && wrangler types --config .wrangler/wrangler.types.jsonc --env-file .wrangler/runtime-secrets.env --strict-vars false && (wrangler dev --env-file .wrangler/runtime-secrets.env --port 8787 & vite dev --mode dev --port 5173 --strictPort)",
		"dev:extension": "pnpm prepare:public:dev && wxt src/frontend/extension --mv3",
		"build:extension": "pnpm prepare:public:prod && wxt zip src/frontend/extension --mv3",
		"deploy:cloudflare": "pnpm prepare:cloudflare:prod && CLOUDFLARE_API_TOKEN=$(cat .wrangler/cloudflare-api-token) wrangler types --config .wrangler/wrangler.types.jsonc --env-file .wrangler/runtime-secrets.env --strict-vars false && vite build && if [ -s .wrangler/runtime-secrets.env ]; then CLOUDFLARE_API_TOKEN=$(cat .wrangler/cloudflare-api-token) wrangler deploy --secrets-file .wrangler/runtime-secrets.env; else CLOUDFLARE_API_TOKEN=$(cat .wrangler/cloudflare-api-token) wrangler deploy; fi",
		"prepare:public:dev": "node scripts/prepare-public.mjs --mode dev",
		"prepare:public:prod": "node scripts/prepare-public.mjs --mode prod",
		"prepare:cloudflare:dev": "node scripts/prepare-cloudflare.mjs --mode dev",
		"prepare:cloudflare:prod": "node scripts/prepare-cloudflare.mjs --mode prod",
		"test": "pnpm exec tsc --noEmit -p tsconfig.tsc.json && pnpm exec svelte-check --tsconfig ./tsconfig.json && vitest",
		"test:e2e": "vitest --config vitest.e2e.config.ts",
		"test:e2e:remote": "E2E_REMOTE=1 vitest --config vitest.e2e.config.ts",
		"test:e2e:first-run": "node scripts/accept-local-first-run.mjs"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@cloudflare/workers-types": "^4.20260409.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@tanstack/table-core": "^8.21.3",
		"@types/hast": "^3.0.4",
		"@types/node": "^22",
		"@wxt-dev/module-svelte": "^2.0.5",
		"bits-ui": "^2.17.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"layerchart": "2.0.0-next.48",
		"mdsvex": "^0.12.7",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"shadcn-svelte": "^1.2.7",
		"sharp": "^0.35.2",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"svelte-sonner": "^1.1.0",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.1",
		"vitest": "^4.1.2",
		"wrangler": "^4.80.0",
		"wxt": "^0.20.27"
	},
	"dependencies": {
		"@better-auth/oauth-provider": "1.6.26",
		"@better-auth/utils": "0.4.2",
		"@better-fetch/fetch": "1.3.1",
		"@google/genai": "^1.49.0",
		"@shikijs/rehype": "^4.0.2",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"better-auth": "^1.6.26",
		"better-call": "1.3.7",
		"creem": "^1.4.4",
		"dodopayments": "^2.31.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.12",
		"mermaid": "^11.14.0",
		"openai": "^6.34.0",
		"rehype-shiki": "^0.0.9",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
