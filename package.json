{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm exec svelte-kit sync && node pre-build.mjs && wrangler types && (wrangler dev --port 8787 & vite dev --port 5173 --strictPort)",
		"deploycf": "node pre-build.mjs --remote && wrangler types && vite build && wrangler deploy",
		"test": "pnpm exec tsc --noEmit -p tsconfig.tsc.json && pnpm exec svelte-check --tsconfig ./tsconfig.json && vitest",
		"test:e2e": "vitest --config vitest.e2e.config.ts",
		"test:e2e:remote": "E2E_REMOTE=1 vitest --config vitest.e2e.config.ts"
	},
